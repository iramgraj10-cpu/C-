<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:CSharpMastery.App.Converters"
             x:Class="CSharpMastery.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:CodeHighlightConverter x:Key="Highlight" />
            <conv:InvertedBoolConverter x:Key="Not" />
            <conv:HasValueConverter x:Key="HasValue" />
            <conv:FeedbackBackgroundConverter x:Key="FeedbackBg" />
            <conv:OptionStrokeConverter x:Key="OptionStroke" />
            <conv:SelectedBackgroundConverter x:Key="SelectedBg" />
            <conv:MasteryColorConverter x:Key="MasteryColor" />
            <conv:PassMarkConverter x:Key="PassMark" />
            <conv:IsPositiveConverter x:Key="Positive" />
            <conv:AllTrueConverter x:Key="AllTrue" />
            <conv:ChipStateConverter x:Key="Chip" />
            <conv:BannerConverter x:Key="Banner" />
            <conv:NodeStateConverter x:Key="Node" />
            <conv:LevelColorConverter x:Key="LevelColor" />
            <conv:IndentMarginConverter x:Key="IndentMargin" />
            <conv:EqualsConverter x:Key="Equals" />
            <conv:AreEqualConverter x:Key="AreEqual" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
