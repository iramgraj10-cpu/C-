<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:CSharpMastery.App.Pages"
       x:Class="CSharpMastery.App.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="C# Mastery">
    <TabBar>
        <ShellContent Title="Inicio" Route="inicio" ContentTemplate="{DataTemplate pages:HomePage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Icons" Glyph="&#xe88a;" Size="26" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Ruta" Route="ruta" ContentTemplate="{DataTemplate pages:CurriculumPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Icons" Glyph="&#xeacd;" Size="26" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Progreso" Route="progreso" ContentTemplate="{DataTemplate pages:ProgressPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Icons" Glyph="&#xe26b;" Size="26" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Proyectos" Route="proyectos" ContentTemplate="{DataTemplate pages:ProjectsPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Icons" Glyph="&#xe87b;" Size="26" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Ajustes" Route="ajustes" ContentTemplate="{DataTemplate pages:SettingsPage}">
            <ShellContent.Icon>
                <FontImageSource FontFamily="Icons" Glyph="&#xe8b8;" Size="26" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
