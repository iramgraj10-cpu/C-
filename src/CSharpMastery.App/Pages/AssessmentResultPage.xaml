<?xml version="1.0" encoding="utf-8" ?>
<local:AssessmentResultPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CSharpMastery.App.Pages"
             xmlns:vm="clr-namespace:CSharpMastery.Presentation.ViewModels.Pages;assembly=CSharpMastery.Presentation"
             x:Class="CSharpMastery.App.Pages.AssessmentResultPage"
             x:DataType="vm:AssessmentResultViewModel"
             Title="Resultados">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="860">
            <Label Text="{Binding Title}" Style="{StaticResource Title}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}" TextColor="{StaticResource ErrorLight}" />
            <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{Binding Passed, Converter={StaticResource FeedbackBg}}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Verdict}" FontSize="17" />
                    <Label Text="{Binding Accuracy}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Por habilidad" Style="{StaticResource Heading}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Skills}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkillScoreLine">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding Title}" FontFamily="{StaticResource FontBold}" />
                                <Label Grid.Column="1" Text="{Binding Score}" FontFamily="{StaticResource FontBold}" />
                                <Label Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="Reforzar" Style="{StaticResource Badge}" IsVisible="{Binding Weak}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasRecovery}" Spacing="8">
                <Label Text="Ruta de recuperación" Style="{StaticResource Heading}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recovery}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecoveryLine">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}" FontFamily="{StaticResource FontBold}" />
                                    <Label Text="{Binding Action}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Repasar la lección" Style="{StaticResource Secondary}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AssessmentResultViewModel}}, Path=OpenLessonCommand, x:DataType=vm:AssessmentResultViewModel}" CommandParameter="{Binding .}" />
                                        <Button Text="Practicar" IsVisible="{Binding HasItems}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AssessmentResultViewModel}}, Path=PracticeRecoveryCommand, x:DataType=vm:AssessmentResultViewModel}" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Button Text="Presentar de nuevo (otras preguntas)" Style="{StaticResource Secondary}" Command="{Binding RetakeCommand}" />
                <Button Text="Ir al inicio" Command="{Binding DoneCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</local:AssessmentResultPageBase>
