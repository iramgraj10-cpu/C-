<?xml version="1.0" encoding="utf-8" ?>
<local:LessonPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CSharpMastery.App.Pages"
             xmlns:views="clr-namespace:CSharpMastery.App.Views"
             xmlns:vm="clr-namespace:CSharpMastery.Presentation.ViewModels.Pages;assembly=CSharpMastery.Presentation"
             x:Class="CSharpMastery.App.Pages.LessonPage"
             x:DataType="vm:LessonViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="860">
            <Label Text="{Binding Title}" Style="{StaticResource Title}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}" TextColor="{StaticResource ErrorLight}" />
            <Border Style="{StaticResource InfoBox}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding MasteryLabel, StringFormat='Estado: {0}'}" FontAttributes="Bold" />
                    <Label Text="{Binding MasteryHelp}" />
                    <Label Text="{Binding ReviewText}" IsVisible="{Binding ReviewText, Converter={StaticResource HasValue}}" Style="{StaticResource Muted}" />
                    <Label Text="{Binding PendingText}" IsVisible="{Binding PendingText, Converter={StaticResource HasValue}}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout IsVisible="{Binding Prerequisites.Count, Converter={StaticResource Positive}}" Spacing="4">
                <Label Text="Antes conviene saber" Style="{StaticResource Heading}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Prerequisites}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PrerequisiteLine">
                            <Button Style="{StaticResource Link}" HorizontalOptions="Start"
                                    Text="{Binding Title, StringFormat='→ {0}'}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LessonViewModel}}, Path=OpenPrerequisiteCommand, x:DataType=vm:LessonViewModel}"
                                    CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsOutline}" Spacing="8">
                <Label Text="{Binding Summary}" />
                <Border Style="{StaticResource InfoBox}">
                    <Label Text="La lección completa de esta habilidad todavía está en preparación. El temario está definido, pero aún no hay ejercicios verificados para ella." />
                </Border>
            </VerticalStackLayout>

            <views:LessonContentView IsVisible="{Binding HasLesson}" BindingContext="{Binding Content}" />

            <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasLesson}">
                <Button Text="Practicar esta lección" Command="{Binding PracticeCommand}" />
                <Button Text="Preguntas de recuerdo" Style="{StaticResource Secondary}" Command="{Binding RecallCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</local:LessonPageBase>
