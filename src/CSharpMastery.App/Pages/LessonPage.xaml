<?xml version="1.0" encoding="utf-8" ?>
<local:LessonPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CSharpMastery.App.Pages"
             xmlns:views="clr-namespace:CSharpMastery.App.Views"
             xmlns:controls="clr-namespace:CSharpMastery.App.Controls"
             xmlns:vm="clr-namespace:CSharpMastery.Presentation.ViewModels.Pages;assembly=CSharpMastery.Presentation"
             x:Class="CSharpMastery.App.Pages.LessonPage"
             x:DataType="vm:LessonViewModel"
             Title="{Binding UnitTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="16" MaximumWidthRequest="720">
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}" TextColor="{StaticResource ErrorLight}" />

            <!-- Portada -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Image Source="mascot_main.png" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" SemanticProperties.Description="Mascota" />
                <Label Text="{Binding UnitTitle}" Style="{StaticResource Badge}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Title}" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
                <Border HorizontalOptions="Center" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,5"
                        BackgroundColor="{Binding Level, Converter={StaticResource MasteryColor}}">
                    <Label Text="{Binding MasteryLabel}" FontFamily="{StaticResource FontBold}" FontSize="14" TextColor="White" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasLesson}" Spacing="12">
                <controls:ChunkyButton Text="{Binding StartText}" Command="{Binding StartLessonCommand}" FontSize="17" />
                <Label Text="Tarjetas cortas, completar código, ordenar líneas, encontrar el error y un ejercicio guiado." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <controls:ChunkyButton Text="Practicar código" Command="{Binding PracticeCommand}" Variant="green" FontSize="14" />
                    <controls:ChunkyButton Grid.Column="1" Text="Preguntas de recuerdo" Command="{Binding RecallCommand}" Variant="blue" FontSize="14" />
                </Grid>
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding MasteryHelp}" />
                    <Label Text="{Binding ReviewText}" IsVisible="{Binding ReviewText, Converter={StaticResource HasValue}}" Style="{StaticResource Muted}" />
                    <Label Text="{Binding PendingText}" IsVisible="{Binding PendingText, Converter={StaticResource HasValue}}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout IsVisible="{Binding Prerequisites.Count, Converter={StaticResource Positive}}" Spacing="6">
                <Label Text="Antes conviene saber" Style="{StaticResource Heading}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Prerequisites}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PrerequisiteLine">
                            <Border Style="{StaticResource Card}" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Text="&#xe5ca;" Style="{StaticResource Icon}" TextColor="{StaticResource Green}" IsVisible="{Binding Met}" />
                                    <Label Text="&#xe897;" Style="{StaticResource Icon}" TextColor="{AppThemeBinding Light=#AFAFAF, Dark=#6F7E86}" IsVisible="{Binding Met, Converter={StaticResource Not}}" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Title}" Style="{StaticResource Strong}" />
                                        <Label Text="{Binding MasteryLabel}" Style="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="&#xe5c4;" Style="{StaticResource Icon}" Rotation="180" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LessonViewModel}}, Path=OpenPrerequisiteCommand, x:DataType=vm:LessonViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsOutline}" Spacing="8">
                <Label Text="{Binding Summary}" />
                <Border Style="{StaticResource InfoBox}">
                    <Label Text="La lección de esta habilidad todavía está en preparación. El temario está definido, pero aún no hay ejercicios verificados para ella." />
                </Border>
            </VerticalStackLayout>

            <!-- Apuntes completos (para consultar, no para estudiar leyendo) -->
            <VerticalStackLayout IsVisible="{Binding HasLesson}" Spacing="12">
                <Button Style="{StaticResource Secondary}" Command="{Binding ToggleNotesCommand}" HorizontalOptions="Fill">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowNotes}" Value="True">
                            <Setter Property="Text" Value="Ocultar apuntes" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowNotes}" Value="False">
                            <Setter Property="Text" Value="Ver apuntes completos" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <views:LessonContentView IsVisible="{Binding ShowNotes}" BindingContext="{Binding Content}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</local:LessonPageBase>
