<?xml version="1.0" encoding="utf-8" ?>
<local:ProjectDetailPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CSharpMastery.App.Pages"
             xmlns:vm="clr-namespace:CSharpMastery.Presentation.ViewModels.Pages;assembly=CSharpMastery.Presentation"
             x:Class="CSharpMastery.App.Pages.ProjectDetailPage"
             x:DataType="vm:ProjectDetailViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="860">
            <Label Text="{Binding Title}" Style="{StaticResource Title}" />
            <Label Text="{Binding Description}" />
            <Border Style="{StaticResource InfoBox}">
                <Label Text="{Binding StatusText}" />
            </Border>

            <Label Text="Requisitos" Style="{StaticResource Heading}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Requirements}" Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding StringFormat='• {0}'}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Criterios de aceptación" Style="{StaticResource Heading}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding AcceptanceCriteria}" Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding StringFormat='✓ {0}'}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Hitos (con pruebas automáticas)" Style="{StaticResource Heading}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Milestones}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MilestoneLine">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding Passed, Converter={StaticResource PassMark}}" FontSize="18" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                    <Label Text="{Binding Description}" />
                                    <Label Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="Trabajar" VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectDetailViewModel}}, Path=WorkOnMilestoneCommand, x:DataType=vm:ProjectDetailViewModel}" CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Autoevaluación con rúbrica" Style="{StaticResource Heading}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rubric}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:RubricLine">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Picker Title="Elige un nivel" ItemsSource="{Binding Levels}" SelectedIndex="{Binding SelectedIndex}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="Notas para ti" Style="{StaticResource Muted}" />
            <Editor Text="{Binding Notes}" AutoSize="TextChanges" MinimumHeightRequest="80" Placeholder="Qué aprendiste, qué mejorarías…" />
            <Button Text="Guardar autoevaluación" Command="{Binding SaveReviewCommand}" HorizontalOptions="Start" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}" TextColor="{StaticResource ErrorLight}" />
        </VerticalStackLayout>
    </ScrollView>
</local:ProjectDetailPageBase>
