<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CSharpMastery.App.Pages"
             xmlns:vm="clr-namespace:CSharpMastery.Presentation.ViewModels.Pages;assembly=CSharpMastery.Presentation"
             xmlns:d="clr-namespace:CSharpMastery.Presentation.ViewModels.Display;assembly=CSharpMastery.Presentation"
             x:Class="CSharpMastery.App.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Ajustes">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="760">
            <Label Text="Ajustes" Style="{StaticResource Title}" />
            <Border Style="{StaticResource InfoBox}" IsVisible="{Binding StatusMessage, Converter={StaticResource HasValue}}">
                <Label Text="{Binding StatusMessage}" />
            </Border>
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource HasValue}}" TextColor="{StaticResource ErrorLight}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="&#xea23;" Style="{StaticResource Icon}" TextColor="{StaticResource Gold}" />
                        <Label Text="Meta diaria" Style="{StaticResource Heading}" Margin="0" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Cuánta XP quieres ganar al día. Ganas XP al acertar ejercicios y al terminar lecciones; leer no da XP." Style="{StaticResource Muted}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding GoalOptions}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="d:OptionDisplay(x:Int32)">
                                <Button Style="{StaticResource Secondary}" Text="{Binding Label}" HorizontalOptions="Fill"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=SetGoalCommand, x:DataType=vm:SettingsViewModel}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource AreEqual}">
                                                    <Binding Path="Value" />
                                                    <Binding Source="{RelativeSource AncestorType={x:Type vm:SettingsViewModel}}" Path="DailyGoal" x:DataType="vm:SettingsViewModel" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BlueSoft}, Dark={StaticResource BlueSoftDark}}" />
                                            <Setter Property="BorderColor" Value="{StaticResource Blue}" />
                                            <Setter Property="TextColor" Value="{StaticResource BlueLedge}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Perfil" Style="{StaticResource Heading}" Margin="0" />
                    <Label Text="Nombre" Style="{StaticResource Muted}" />
                    <Border Style="{StaticResource InputBox}"><Entry Text="{Binding DisplayName}" SemanticProperties.Description="Nombre" /></Border>
                    <Label Text="Experiencia inicial" Style="{StaticResource Muted}" />
                    <Picker ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" />
                    <Label Text="Duración preferida de sesión (minutos, 10–90)" Style="{StaticResource Muted}" />
                    <Entry Text="{Binding PreferredMinutes}" Keyboard="Numeric" WidthRequest="120" HorizontalOptions="Start" />
                    <Label Text="Tema" Style="{StaticResource Muted}" />
                    <Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                    <Button Text="Guardar perfil" Command="{Binding SaveProfileCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Criterios de dominio" Style="{StaticResource Heading}" Margin="0" />
                    <Label Text="Definen cuándo una habilidad cuenta como dominada. Los valores recomendados son exigentes a propósito." Style="{StaticResource Muted}" />
                    <Grid ColumnDefinitions="*,100" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                        <Label Text="Precisión mínima reciente (%)" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding MinAccuracyPercent}" Keyboard="Numeric" />
                        <Label Grid.Row="1" Text="Intentos calificados mínimos" VerticalOptions="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding MinGradedAttempts}" Keyboard="Numeric" />
                        <Label Grid.Row="2" Text="Ventana de intentos recientes" VerticalOptions="Center" />
                        <Entry Grid.Row="2" Grid.Column="1" Text="{Binding AccuracyWindow}" Keyboard="Numeric" />
                        <Label Grid.Row="3" Text="Ejercicios de código resueltos sin ayuda" VerticalOptions="Center" />
                        <Entry Grid.Row="3" Grid.Column="1" Text="{Binding MinIndependentCode}" Keyboard="Numeric" />
                        <Label Grid.Row="4" Text="Problemas de transferencia resueltos" VerticalOptions="Center" />
                        <Entry Grid.Row="4" Grid.Column="1" Text="{Binding MinTransfer}" Keyboard="Numeric" />
                        <Label Grid.Row="5" Text="Días mínimos para confirmar retención" VerticalOptions="Center" />
                        <Entry Grid.Row="5" Grid.Column="1" Text="{Binding RetentionDays}" Keyboard="Numeric" />
                        <Label Grid.Row="6" Text="Aciertos para aprobar evaluaciones (%)" VerticalOptions="Center" />
                        <Entry Grid.Row="6" Grid.Column="1" Text="{Binding AssessmentPassPercent}" Keyboard="Numeric" />
                    </Grid>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Guardar criterios" Command="{Binding SaveCriteriaCommand}" />
                        <Button Text="Restaurar recomendados" Style="{StaticResource Secondary}" Command="{Binding RestoreDefaultCriteriaCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Respaldo" Style="{StaticResource Heading}" Margin="0" />
                    <Label Text="Exporta todo tu progreso a un archivo JSON y restáuralo en este u otro dispositivo." Style="{StaticResource Muted}" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Exportar progreso" Command="{Binding ExportCommand}" />
                        <Button Text="Restaurar desde archivo" Style="{StaticResource Secondary}" Command="{Binding ImportCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ejecución de código" Style="{StaticResource Heading}" Margin="0" />
                    <Label Text="{Binding EngineStatus}" Style="{StaticResource Strong}" />
                    <Label Text="{Binding EngineMessage}" />
                    <Button Text="Probar el motor" Style="{StaticResource Secondary}" Command="{Binding TestEngineCommand}" HorizontalOptions="Start" />
                    <Label Text="{Binding EngineTestResult}" IsVisible="{Binding EngineTestResult, Converter={StaticResource HasValue}}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Privacidad" Style="{StaticResource Heading}" Margin="0" />
                    <Label Text="{Binding PrivacyText}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</local:SettingsPageBase>
