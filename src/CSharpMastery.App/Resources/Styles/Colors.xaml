<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!--
        Paleta alegre y de alto contraste. Cada color de botón tiene su «repisa» (un tono más oscuro) que da el
        efecto de botón en relieve. Los sufijos Light/Dark son el tema claro y el oscuro.
    -->
    <Color x:Key="Brand">#7C4DFF</Color>
    <Color x:Key="BrandLedge">#5B2FD6</Color>
    <Color x:Key="BrandSoft">#EDE7FF</Color>
    <Color x:Key="BrandSoftDark">#2B2552</Color>
    <Color x:Key="Green">#46C21C</Color>
    <Color x:Key="GreenLedge">#36A00E</Color>
    <Color x:Key="GreenText">#2B8A0E</Color>
    <Color x:Key="GreenTextDark">#79E04F</Color>
    <Color x:Key="Red">#FF4B4B</Color>
    <Color x:Key="RedLedge">#E03A3A</Color>
    <Color x:Key="RedText">#D33131</Color>
    <Color x:Key="RedTextDark">#FF7B7B</Color>
    <Color x:Key="Gold">#FFC800</Color>
    <Color x:Key="GoldLedge">#E0A800</Color>
    <Color x:Key="Flame">#FF9600</Color>
    <Color x:Key="Blue">#1CB0F6</Color>
    <Color x:Key="BlueLedge">#1899D6</Color>
    <Color x:Key="BlueSoft">#DDF4FF</Color>
    <Color x:Key="BlueSoftDark">#173A4C</Color>
    <Color x:Key="Gray">#E5E5E5</Color>
    <Color x:Key="GrayLedge">#C9C9C9</Color>
    <Color x:Key="GrayDark">#37464F</Color>
    <Color x:Key="GrayLedgeDark">#2A363D</Color>

    <!-- Nombres heredados que usan todas las pantallas. -->
    <Color x:Key="Primary">#7C4DFF</Color>
    <Color x:Key="PrimaryDark">#A98BFF</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#FFFFFF</Color>

    <Color x:Key="PageLight">#FFFFFF</Color>
    <Color x:Key="PageDark">#131F24</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#202F36</Color>
    <Color x:Key="BorderLight">#E5E5E5</Color>
    <Color x:Key="BorderDark">#37464F</Color>
    <Color x:Key="TextLight">#3C3C3C</Color>
    <Color x:Key="TextDark">#F1F7FB</Color>
    <Color x:Key="MutedLight">#777777</Color>
    <Color x:Key="MutedDark">#A0AEB5</Color>

    <Color x:Key="SuccessLight">#2B8A0E</Color>
    <Color x:Key="SuccessDark">#79E04F</Color>
    <Color x:Key="ErrorLight">#D33131</Color>
    <Color x:Key="ErrorDark">#FF7B7B</Color>
    <Color x:Key="WarningLight">#9A5B00</Color>
    <Color x:Key="WarningDark">#FFC24D</Color>
    <Color x:Key="SuccessBgLight">#D7FFB8</Color>
    <Color x:Key="SuccessBgDark">#1E3A14</Color>
    <Color x:Key="ErrorBgLight">#FFDFE0</Color>
    <Color x:Key="ErrorBgDark">#3F1F22</Color>
    <Color x:Key="InfoBgLight">#EDE7FF</Color>
    <Color x:Key="InfoBgDark">#2B2552</Color>

    <!-- Código (fondo oscuro en ambos temas para que el resaltado se lea bien). -->
    <Color x:Key="CodeBackground">#1E1B33</Color>
    <Color x:Key="CodeText">#E6E6EF</Color>
    <Color x:Key="CodeLineNumber">#7F7F95</Color>
    <Color x:Key="CodeKeyword">#C792EA</Color>
    <Color x:Key="CodeType">#82AAFF</Color>
    <Color x:Key="CodeString">#C3E88D</Color>
    <Color x:Key="CodeNumber">#F78C6C</Color>
    <Color x:Key="CodeComment">#8A93A8</Color>
</ResourceDictionary>
