<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Paleta con contraste suficiente (texto sobre fondo ≥ 4.5:1) en ambos temas. -->
    <Color x:Key="Primary">#4B2A8A</Color>
    <Color x:Key="PrimaryDark">#C9B6F2</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#1C1030</Color>

    <Color x:Key="PageLight">#F7F6FA</Color>
    <Color x:Key="PageDark">#121216</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E1E24</Color>
    <Color x:Key="BorderLight">#D9D6E0</Color>
    <Color x:Key="BorderDark">#3A3A44</Color>
    <Color x:Key="TextLight">#1B1B1F</Color>
    <Color x:Key="TextDark">#ECECF1</Color>
    <Color x:Key="MutedLight">#55535E</Color>
    <Color x:Key="MutedDark">#B4B2BE</Color>

    <Color x:Key="SuccessLight">#1E6B34</Color>
    <Color x:Key="SuccessDark">#7BD88F</Color>
    <Color x:Key="ErrorLight">#A1262B</Color>
    <Color x:Key="ErrorDark">#FF9A9E</Color>
    <Color x:Key="WarningLight">#7A4B00</Color>
    <Color x:Key="WarningDark">#F2C46D</Color>
    <Color x:Key="SuccessBgLight">#E5F4E8</Color>
    <Color x:Key="SuccessBgDark">#1D3324</Color>
    <Color x:Key="ErrorBgLight">#FBE7E8</Color>
    <Color x:Key="ErrorBgDark">#3A1E21</Color>
    <Color x:Key="InfoBgLight">#EEE8F8</Color>
    <Color x:Key="InfoBgDark">#2A2340</Color>

    <!-- Código (fondo oscuro en ambos temas para legibilidad de resaltado). -->
    <Color x:Key="CodeBackground">#1E1E2A</Color>
    <Color x:Key="CodeText">#E6E6EF</Color>
    <Color x:Key="CodeLineNumber">#7F7F95</Color>
    <Color x:Key="CodeKeyword">#C792EA</Color>
    <Color x:Key="CodeType">#82AAFF</Color>
    <Color x:Key="CodeString">#C3E88D</Color>
    <Color x:Key="CodeNumber">#F78C6C</Color>
    <Color x:Key="CodeComment">#8A93A8</Color>
</ResourceDictionary>
