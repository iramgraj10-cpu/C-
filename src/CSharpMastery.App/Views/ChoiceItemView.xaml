<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CSharpMastery.App.Views"
             xmlns:items="clr-namespace:CSharpMastery.Presentation.ViewModels.Items;assembly=CSharpMastery.Presentation"
             x:Class="CSharpMastery.App.Views.ChoiceItemView"
             x:DataType="items:ChoiceItemViewModel">
    <VerticalStackLayout Spacing="14">
        <views:ItemHeaderView />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}" Spacing="10">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="items:ChoiceOptionViewModel">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="0,0,0,3"
                            BackgroundColor="{Binding RevealedCorrect, Converter={StaticResource OptionStroke}}">
                        <Border Padding="14,12" StrokeThickness="2" StrokeShape="RoundRectangle 16"
                                Stroke="{Binding RevealedCorrect, Converter={StaticResource OptionStroke}}"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectedBg}}"
                                SemanticProperties.Description="{Binding Text}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border StrokeThickness="2" StrokeShape="RoundRectangle 8" WidthRequest="32" HeightRequest="32" VerticalOptions="Center"
                                        Stroke="{Binding RevealedCorrect, Converter={StaticResource OptionStroke}}">
                                    <Label Text="{Binding Letter}" FontFamily="{StaticResource FontBlack}" FontSize="15"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Style="{StaticResource Muted}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource FontSemi}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type items:ChoiceItemViewModel}}, Path=SelectCommand, x:DataType=items:ChoiceItemViewModel}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
        <views:ItemFooterView />
    </VerticalStackLayout>
</ContentView>
