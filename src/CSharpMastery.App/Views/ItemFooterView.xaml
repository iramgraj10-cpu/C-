<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:CSharpMastery.Presentation.ViewModels.Items;assembly=CSharpMastery.Presentation"
             x:Class="CSharpMastery.App.Views.ItemFooterView"
             x:DataType="items:ItemViewModel">
    <!-- Pistas progresivas. La corrección y «Continuar» van en el pie fijo de la pantalla. -->
    <VerticalStackLayout Spacing="10">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RevealedHints}" Spacing="8">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border StrokeThickness="2" StrokeShape="RoundRectangle 14" Padding="14" Stroke="{StaticResource Gold}"
                            BackgroundColor="{AppThemeBinding Light=#FFF7D6, Dark=#3A3214}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="&#xe0f0;" Style="{StaticResource Icon}" TextColor="{StaticResource GoldLedge}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
        <Button Text="{Binding HintButtonText}" Style="{StaticResource Secondary}" HorizontalOptions="Start"
                Command="{Binding RevealHintCommand}" IsVisible="{Binding HasMoreHints}" />
    </VerticalStackLayout>
</ContentView>
