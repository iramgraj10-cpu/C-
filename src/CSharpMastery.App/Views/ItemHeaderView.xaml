<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CSharpMastery.App.Controls"
             xmlns:items="clr-namespace:CSharpMastery.Presentation.ViewModels.Items;assembly=CSharpMastery.Presentation"
             x:Class="CSharpMastery.App.Views.ItemHeaderView"
             x:DataType="items:ItemViewModel">
    <VerticalStackLayout Spacing="12">
        <Label Text="{Binding PurposeLabel}" Style="{StaticResource Badge}" />
        <Label Text="{Binding Prompt}" FontFamily="{StaticResource FontBold}" FontSize="19" SemanticProperties.HeadingLevel="Level2" />
        <controls:CodeView Code="{Binding Code}" IsVisible="{Binding HasCode}" />
        <Border IsVisible="{Binding AskConfidence}" Style="{StaticResource InfoBox}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Antes de responder: ¿qué tan seguro estás?" Style="{StaticResource Strong}" />
                <Picker Title="Elige tu confianza" ItemsSource="{Binding ConfidenceOptions}"
                        SelectedItem="{Binding SelectedConfidence}" HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
