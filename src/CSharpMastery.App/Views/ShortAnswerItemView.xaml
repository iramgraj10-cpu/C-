<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CSharpMastery.App.Views"
             xmlns:items="clr-namespace:CSharpMastery.Presentation.ViewModels.Items;assembly=CSharpMastery.Presentation"
             x:Class="CSharpMastery.App.Views.ShortAnswerItemView"
             x:DataType="items:ShortAnswerItemViewModel">
    <VerticalStackLayout Spacing="14">
        <views:ItemHeaderView />
        <Border Style="{StaticResource CodeBox}" Padding="6" IsVisible="{Binding IsMultiline}">
            <Editor Text="{Binding Answer}" Placeholder="{Binding Placeholder}" Style="{StaticResource CodeEditor}"
                    MinimumHeightRequest="100" SemanticProperties.Description="Tu respuesta" />
        </Border>
        <Border Style="{StaticResource InputBox}" IsVisible="{Binding IsMultiline, Converter={StaticResource Not}}">
            <Entry Text="{Binding Answer}" Placeholder="{Binding Placeholder}" FontFamily="{StaticResource MonoFont}"
                   ReturnCommand="{Binding PrimaryCommand}" SemanticProperties.Description="Tu respuesta" />
        </Border>
        <views:ItemFooterView />
    </VerticalStackLayout>
</ContentView>
